---
import { getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import MainSection from '@components/ui/sections/MainSection.astro'

const entries = await getCollection('friends')
const friends = entries[0]?.data ?? []
---
<BaseLayout title="友链" description="一些值得阅读的博客，与同样热爱技术和分享的朋友相遇。"><MainSection title="与朋友们相遇" subTitle="一些值得阅读的博客，分享技术、经验与生活中的发现。" /><section class="container page-section"><div class="article-grid">{friends.map(friend => <article class="friend-card panel"><div class="friend-top"><img src={friend.avatar} alt={`${friend.name} 的头像`} width="58" height="58" loading="lazy" /><div><h2>{friend.name}</h2><small>{friend.title}</small></div></div><p>{friend.description}</p><div class="friend-links">{friend.social.blog && <a href={friend.social.blog} target="_blank" rel="noopener noreferrer">博客 ↗</a>}{friend.social.github && <a href={`https://github.com/${friend.social.github}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}{friend.social.twitter && <a href={`https://x.com/${friend.social.twitter}`} target="_blank" rel="noopener noreferrer">X ↗</a>}</div></article>)}</div></section></BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro'
import LifeSnapshotsTimeline from '@/components/react/LifeSnapshotsTimeline'

const pageTitle = 'Life in Snapshots'
const pageDescription = 'A visual journey through moments that matter - travels, daily experiences, and memories captured over time.'
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <section class="mx-auto mt-10 px-4 sm:px-6 lg:px-8 lg:pt-10 2xl:max-w-full max-w-[85rem] pb-10 lg:pb-14">
        <div class="max-w-2xl mx-auto text-center mb-10 lg:mb-14">
            <h1 class="text-3xl font-bold text-neutral-800 dark:text-white sm:text-4xl md:text-5xl">
                Life in Snapshots
            </h1>
            <p class="mt-3 text-neutral-600 dark:text-neutral-400">
                A visual journey through moments that matter
            </p>
        </div>
        <LifeSnapshotsTimeline client:load />
    </section>
</BaseLayout>

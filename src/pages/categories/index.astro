---
import { getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import MainSection from '@components/ui/sections/MainSection.astro'
import BlogCategory from '@components/blog/BlogCategory.astro'
import { sortPosts } from '@support/posts'
import { formatDate } from '@support/time'

const categories = await getCollection('categories')
const posts = sortPosts(await getCollection('posts'))
const description = '按技术主题整理文章，找到你感兴趣的开发工具、框架与实践笔记。'
---
<BaseLayout title="技术分类" description={description}><MainSection title="技术分类" subTitle={description} /><section class="container page-section"><div class="category-grid">{categories.map((category) => {
    const entries = posts.filter(post => post.data.category === category.slug)
    return <BlogCategory slug={category.slug} title={category.data.title} description={category.data.description} count={entries.length} publishDate={entries[0] ? formatDate(entries[0].data.pubDate) : undefined} />
})}</div></section></BaseLayout>

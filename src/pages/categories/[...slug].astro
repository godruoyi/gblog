---
import { type CollectionEntry, getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import MainSection from '@components/ui/sections/MainSection.astro'
import BlogCard from '@components/blog/BlogCard.astro'
import { sortPosts } from '@support/posts'

export async function getStaticPaths() {
    return (await getCollection('categories')).map(category => ({ params: { slug: category.slug }, props: { category } }))
}
interface Props { category: CollectionEntry<'categories'> }
const { category } = Astro.props
const posts = sortPosts(await getCollection('posts')).filter(post => post.data.category === category.slug)
---
<BaseLayout title={category.data.title} description={category.data.description}><MainSection title={category.data.title} subTitle={category.data.description} btnExists btnTitle="全部分类" btnURL="/categories/" /><section class="container page-section panel">{posts.length > 0 ? <div class="article-grid">{posts.map(blog => <BlogCard blog={blog} />)}</div> : <div class="empty-state"><p>该分类暂时还没有文章。</p><a class="text-link" href="/posts/">先看看其他文章 →</a></div>}</section></BaseLayout>

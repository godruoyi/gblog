---
import { type CollectionEntry, getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '@layouts/BaseLayout.astro'
import BlogComments from '@components/blog/BlogComments'
import BlogToc from '@components/blog/BlogToc.astro'
import BlogRelated from '@components/blog/BlogRelated.astro'
import BrandLogo from '@components/ui/logos/BrandLogo.astro'
import { formatDate } from '@support/time'
import { getPostNavigation, getRelatedPosts } from '@support/posts'
import { SITE, Settings } from '@/config'

export async function getStaticPaths() {
    return (await getCollection('posts')).map(post => ({ params: { slug: post.slug }, props: post }))
}

type Props = CollectionEntry<'posts'>
const post = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await post.render()
const categories = await getCollection('categories')
const category = categories.find(entry => entry.slug === post.data.category)
const posts = await getCollection('posts')
const related = getRelatedPosts(posts, post)
const { previous, next } = getPostNavigation(posts, post.slug)
const url = new URL(Astro.url.pathname, SITE.url).href
---
<BaseLayout
    title={post.data.title}
    description={post.data.description}
    ogImage={post.data.ogImage ?? post.data.banner}
    structuredData={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    'inLanguage': 'zh-CN',
    '@id': url,
    'url': url,
    'headline': post.data.title,
    'description': post.data.description,
    'datePublished': post.data.pubDate.toISOString(),
    'dateModified': (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    'author': { '@type': 'Person', 'name': SITE.author, 'url': SITE.url },
}}
>
    <section class:list={['post-hero', { 'rg200u-hero': post.slug === 'rg200u-5g-debug' }]}>
        <Image class="hero-background" src={post.data.banner} width={1672} height={941} alt={post.data.title} loading="eager" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="container"><p class="hero-kicker handwritten"><a href={`/categories/${post.data.category}/`}>{category?.data.title ?? post.data.category}</a> · 技术与实践</p><h1>{post.data.title}</h1><p class="post-description">{post.data.description}</p><div class="author-inline"><BrandLogo /><span><strong>{SITE.author}</strong><small><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> · {remarkPluginFrontmatter.minutesRead}</small></span></div></div>
    </section>
    <div class="container post-layout">
        <div class="post-main">
            <article class="post-body"><Content /></article>
            <div class="tags post-tags">{(post.data.tags ?? [category?.data.title ?? post.data.category]).map(tag => <span class="tag">{tag}</span>)}</div>
            <BlogRelated posts={related} class="mobile-related" />
            <nav class="post-navigation panel" aria-label="上一篇和下一篇">
                {previous && <a class="previous-post" href={`/posts/${previous.slug}/`}><Image src={previous.data.banner2 ?? previous.data.banner} width={150} height={130} alt="" loading="lazy" /><span><small>← 上一篇</small><strong>{previous.data.title}</strong></span></a>}
                {next && <a class="next-post" href={`/posts/${next.slug}/`}><Image src={next.data.banner2 ?? next.data.banner} width={150} height={130} alt="" loading="lazy" /><span><small>下一篇 →</small><strong>{next.data.title}</strong></span></a>}
            </nav>
            <section class="author-card panel" aria-label="博客作者"><a class="brand" href="/"><BrandLogo class="brand-logo" /><span><strong>{SITE.author}</strong><small>{SITE.shortDescription}</small></span></a><p>{SITE.description}</p><a class="button primary" href="/posts/">全部文章 →</a></section>
            {Settings.Comment.enable && <section class="comments-section" aria-label="文章评论"><BlogComments legacyTitle={post.data.commentTitle} client:only="react" /></section>}
        </div>
        <aside class="post-sidebar" aria-label="阅读导航"><BlogToc headings={headings} /><BlogRelated posts={related} /></aside>
    </div>
</BaseLayout>

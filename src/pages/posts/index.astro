---
import { getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import BlogRecentCard from '@components/blog/BlogRecentCard.astro'
import BlogSelectedArticle from '@components/blog/BlogSelectedArticle.astro'
import MainSection from '@components/ui/sections/MainSection.astro'
import { sortPosts } from '@support/posts'

const posts = sortPosts(await getCollection('posts'))
const description = '记录技术学习与开发实践，把遇到的问题和有用的发现整理成文章。'
---
<BaseLayout title="全部文章" description={description}><MainSection title="把探索写成笔记" subTitle={`目前共 ${posts.length} 篇文章。${description}`} btnExists btnTitle="按时间浏览" btnURL="/timeline/" /><BlogRecentCard blogs={posts} /><BlogSelectedArticle posts={posts.filter(post => post.data.selected)} /></BaseLayout>

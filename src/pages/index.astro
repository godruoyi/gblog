---
import { getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import BlogInsight from '@components/blog/BlogInsight.astro'
import HeroSection from '@components/ui/sections/HeroSection.astro'
import FeaturesSection from '@components/ui/sections/FeaturesSection.astro'
import HeroSectionAlt from '@components/ui/sections/HeroSectionAlt.astro'
import { sortPosts } from '@support/posts'

const posts = sortPosts(await getCollection('posts'))
const categories = await getCollection('categories')
---
<BaseLayout>
    <HeroSection />
    <section class="container stats-panel panel" aria-label="博客概览">
        <div><span class="stat-icon" aria-hidden="true">▤</span><p><strong>{posts.length} 篇</strong><small>技术文章</small></p></div>
        <div><span class="stat-icon" aria-hidden="true">▦</span><p><strong>{categories.length} 个</strong><small>技术分类</small></p></div>
        <div><span class="stat-icon" aria-hidden="true">⌘</span><p><strong>开源探索</strong><small>持续学习与分享</small></p></div>
        <div><span class="stat-icon" aria-hidden="true">⚙</span><p><strong>实践记录</strong><small>让知识连接现实</small></p></div>
        <p class="handwritten stats-note">保持热爱，<br />把探索写成笔记。</p>
    </section>
    <FeaturesSection />
    <section class="container recent-section panel"><div class="section-heading"><div><p class="eyebrow">最近更新</p><h2>最新文章</h2></div><a class="text-link" href="/posts/">查看全部文章 <span aria-hidden="true">→</span></a></div><div class="article-grid">{posts.slice(0, 3).map(blog => <BlogInsight blog={blog} />)}</div></section>
    <HeroSectionAlt />
</BaseLayout>

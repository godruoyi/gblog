---
import { Image } from 'astro:assets'
import terminal from '@images/theme/terminal-monitor.png'
import notebook from '@images/theme/field-notebook.png'
import board from '@images/theme/development-board.png'

interface Props { slug: string, title: string, description: string, count: number, publishDate?: string }
const { slug, title, description, count, publishDate } = Astro.props
const marks: Record<string, string> = { astro: '✦', laravel: 'L', mysql: 'SQL', php: 'php' }
const images = { tool: terminal, whatis: notebook, embedded: board }
const image = images[slug as keyof typeof images]
---
<a class="category-card panel" href={`/categories/${slug}/`}>
    <div class="category-icon">{image ? <Image src={image} width={100} height={100} alt="" loading="lazy" /> : <span>{marks[slug] ?? '#'}</span>}</div>
    <div class="category-copy"><h3>{title}</h3><p>{description}</p><div class="category-meta"><span class="tag">{count} 篇文章</span>{publishDate && count > 0 && <small>更新于 {publishDate}</small>}</div></div>
    <span class="round-arrow" aria-hidden="true">↗</span>
</a>

---
import type { CollectionEntry } from 'astro:content'
import BlogCard from './BlogCard.astro'

interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props
---
{posts.length > 0 && <section class="container page-section panel"><p class="eyebrow">值得一读</p><h2 class="section-title">精选文章</h2><div class="article-grid">{posts.map(blog => <BlogCard blog={blog} />)}</div></section>}

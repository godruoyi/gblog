---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@support/time'

interface Props { blog: CollectionEntry<'posts'> }
const { blog } = Astro.props
---
<div class="timeline-item"><time datetime={blog.data.pubDate.toISOString()}>{formatDate(blog.data.pubDate)}</time><a href={`/posts/${blog.slug}/`}><h2>{blog.data.title}</h2><p>{blog.data.description}</p></a></div>

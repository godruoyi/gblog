---
import { Image } from 'astro:assets'
import BrandLogo from '@components/ui/logos/BrandLogo.astro'
import mountain from '@images/theme/circuit-mountains.png'
import { NavigationLinks, SITE } from '@/config'
---

<footer class="site-footer container">
    <div class="footer-brand"><a class="brand" href="/"><BrandLogo class="brand-logo" /><span><strong>{SITE.author}</strong><small>{SITE.shortDescription}</small></span></a><p>© {new Date().getFullYear()} {SITE.author} · 保持好奇，持续记录</p></div>
    <nav class="footer-nav" aria-label="页脚导航">{NavigationLinks.map(link => <a href={link.url}>{link.name}</a>)}</nav>
    <div class="footer-links"><a href="https://github.com/yongjian-peng" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/sitemap-index.xml">站点地图</a></div>
    <Image class="footer-mountains" src={mountain} width={340} alt="" loading="lazy" />
</footer>

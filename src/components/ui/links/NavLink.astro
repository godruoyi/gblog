---
const { url, name } = Astro.props
interface Props { url: string, name: string }
const path = Astro.url.pathname.replace(/\/$/, '')
const active = url === '/posts/gblog' ? path === url : (path === url || (path.startsWith(`${url}/`) && path !== '/posts/gblog'))
---
<a href={url} class:list={['nav-link', { active }]} aria-current={active ? 'page' : undefined}>{name}</a>

---
interface Props { title: string, subTitle?: string, btnExists?: boolean, btnTitle?: string, btnURL?: string }
const { title, subTitle, btnExists, btnTitle, btnURL } = Astro.props
---
<section class="container page-heading"><div class="page-heading-inner"><div><p class="eyebrow">学习 · 实践 · 记录</p><h1>{title}</h1>{subTitle && <p>{subTitle}</p>}</div>{btnExists && btnURL && <a class="button secondary" href={btnURL}>{btnTitle} →</a>}</div></section>

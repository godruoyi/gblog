---
import { getCollection } from 'astro:content'
import BlogCategory from '@components/blog/BlogCategory.astro'

const categories = await getCollection('categories')
const posts = await getCollection('posts')
---
<section class="container categories-section">
    <div class="section-heading"><div><p class="eyebrow">技术分类</p><h2>我在记录什么</h2><p>从开发工具到框架实践，整理探索过程中的知识与经验。<br />每一个分类，都是持续学习的足迹。</p></div><p class="handwritten section-note">保持好奇，<br />让想法落在代码里。</p></div>
    <div class="category-grid">{categories.map(category => <BlogCategory slug={category.slug} title={category.data.title} description={category.data.description} count={posts.filter(post => post.data.category === category.slug).length} />)}</div>
</section>
